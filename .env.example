DATABASE_URL=""
# Runtime: mantenha development localmente. O host fornece PORT na publicação.
NODE_ENV=development
PORT=3000
# Pokémon TCG API (TCGGO), assinatura no RapidAPI. Apenas no backend.
TCGGO_RAPIDAPI_KEY=
# Segredo de assinatura JWT (aleatório, mínimo de 32 bytes).
JWT_SECRET=
# Prazo para pagamento de pedidos novos sem cobrança em andamento (1 a 1440 minutos).
ORDER_RESERVATION_MINUTES=30
# sandbox (padrão) ou production. As chaves de cada ambiente são distintas.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
# Token próprio do webhook (32 a 255 caracteres, sem espaços; diferente da API key).
ASAAS_WEBHOOK_TOKEN=

# Origem e contato técnico para as APIs de frete. Peso e dimensões estão em shipping-package.ts.
SHIPPING_ORIGIN_ZIP_CODE=78556858
SHIPPING_CONTACT_EMAIL=
MELHOR_ENVIO_ENVIRONMENT=sandbox
MELHOR_ENVIO_TOKEN=
SUPERFRETE_ENVIRONMENT=sandbox
SUPERFRETE_TOKEN=
# A API de cotações Frenet usa o ambiente real; configure somente o token da sua conta.
FRENET_TOKEN=

# Remetente para etiquetas Melhor Envio. Preencha com dados reais da loja, mesmo no sandbox.
SHIPPING_SENDER_NAME=
SHIPPING_SENDER_DOCUMENT=
SHIPPING_SENDER_PHONE=
SHIPPING_SENDER_EMAIL=
SHIPPING_SENDER_STREET=
SHIPPING_SENDER_NUMBER=
SHIPPING_SENDER_COMPLEMENT=
SHIPPING_SENDER_NEIGHBORHOOD=
SHIPPING_SENDER_CITY=
SHIPPING_SENDER_STATE=MT
SHIPPING_SENDER_STATE_REGISTER=

# Sincronização automática de etiquetas Melhor Envio (intervalo de 30 a 3600 segundos)
SHIPPING_LABEL_SYNC_ENABLED=true
SHIPPING_LABEL_SYNC_INTERVAL_SECONDS=60

# Origens exatas do frontend, separadas por vírgula. Sem curingas.
# Exemplo local: http://localhost:5173
AUTH_ALLOWED_ORIGINS=

# Recuperação de senha por e-mail. Apenas no backend; não há envio sem configuração.
# Guia: docs/email-setup.md. Após o build: npm run email:check (não envia mensagens).
# SMTP usa TLS obrigatório: porta 465 para TLS direto ou 587 para STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# URL pública do frontend, sem query ou fragmento. Exemplo local: http://localhost:5173/
PASSWORD_RESET_URL=
